# ============================================================================
# .env mẫu — copy thành .env, điền giá trị thật. Dùng chung cho toàn bộ service
# qua docker-compose env_file (mỗi service override PORT/DB_*/REDIS_*/
# *_SERVICE_URL riêng trong docker-compose.yml, không đặt ở đây).
# ============================================================================

NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT — dùng chung bởi user-service (issue) và recommendation-service (verify)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Khoá gọi nội bộ giữa các service (route /internal/*) — chuỗi ngẫu nhiên mạnh
INTERNAL_API_KEY=your_internal_api_key_here

# Mailer (user-service — gửi OTP)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=no-reply@xedich.space

# Google OAuth (user-service — scaffold, chưa dùng)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# LiteAPI (hotel-service)
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_API_KEY=your_liteapi_api_key
HOTEL_SYNC_MAX_PER_CITY=1000

# Ignav (transport-service)
IGNAV_API_KEY=your_ignav_api_key

# OpenTripMap (recommendation-service — module place)
OPENTRIPMAP_BASE_URL=https://api.opentripmap.com/0.1/en
OPENTRIPMAP_API_KEY=your_opentripmap_api_key

# Google Gemini (ai-service — CHỈ service này cần key, các service khác gọi qua HTTP)
GEMINI_KEY=your_gemini_api_key
LLM_MODEL=gemini-flash-latest

# Google Maps (chưa dùng — chờ tính năng bản đồ)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Budget — recommendation-service (fallback khi places.avg_cost chưa enrich)
BUDGET_MEAL_COST_VND=100000
BUDGET_ATTRACTION_FEE_VND=50000
BUDGET_TRANSPORT_VND_PER_DAY=250000
BUDGET_TRANSPORT_BIKE_BASE_VND=13000
BUDGET_TRANSPORT_BIKE_PER_KM_VND=4300
BUDGET_TRANSPORT_CAR_BASE_VND=20000
BUDGET_TRANSPORT_CAR_PER_KM_VND=12000
BUDGET_TRANSPORT_ROAD_FACTOR=1.3
USD_VND_RATE=26500
